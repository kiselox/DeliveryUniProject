# =========================================================================
# POLONEZ Delivery — Пример файла конфигурации окружения (.env)
# Скопируйте этот файл в новый файл с именем `.env` и настройте значения:
# cp .env.example .env
# =========================================================================

# Порт для запуска Express бэкенд-сервера
PORT=3001

# Строка подключения к PostgreSQL + PostGIS (Промышленный режим)
# Если закомментировано или оставлено пустым, сервер автоматически переключится в локальный JSON-режим (db.json)
# DATABASE_URL=postgresql://username:password@localhost:5432/polonez_delivery?sslmode=disable

# API-ключ для интеграции с Google Maps (для будущей интеграции из Roadmap)
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
